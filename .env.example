# QuoteFlow environment configuration
#
# Copy this file to `.env` in the repository root for local development:
#   cp .env.example .env
# Both apps read the root `.env` in development. In production, set these as
# real environment variables on your hosting platform — never commit `.env`.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# MongoDB connection string (required). Include the database name.
#   Local:  mongodb://127.0.0.1:27017/quoteflow
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/quoteflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quoteflow

# Secret used to sign access tokens (required, at least 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Lifetime of a signed access token (e.g. 15m, 1h).
ACCESS_TOKEN_TTL=15m

# Lifetime of a refresh session, in days.
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of browser origins allowed to call the API.
# Required in production.
CORS_ORIGIN=http://localhost:5173

# Public URL of the web app. Used to build customer-facing links
# (e.g. public quote pages). Required in production.
APP_URL=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (0 when the API is
# exposed directly, 1 behind a single load balancer / PaaS router).
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web (apps/web) — only VITE_* variables are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the API. Leave empty in development to use the Vite proxy
# (requests to /api are forwarded to http://localhost:4000).
VITE_API_URL=
