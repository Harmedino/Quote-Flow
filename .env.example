# QuoteFlow environment configuration
#
# Copy this file to `.env` in the repository root for local development:
#   cp .env.example .env
# Both apps read the root `.env` in development. In production, set these as
# real environment variables on your hosting platform — never commit `.env`.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# NODE_ENV (development | test | production) is deliberately not set here: the
# API defaults to development, and production hosts must set
# NODE_ENV=production as a real environment variable. Vite also reads this file,
# and NODE_ENV=development in it would make `pnpm build` emit a development
# build of the web app.

# Port the API listens on.
PORT=4000

# MongoDB connection string (required). It must include the database name;
# without one the driver would silently use a database called "test".
#   Local:  mongodb://127.0.0.1:27017/quoteflow
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/quoteflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quoteflow

# Secret used to sign access tokens (required, at least 32 characters; in
# production it must be a random value, not a repeated placeholder).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Lifetime of a signed access token, between 1m and 1h (e.g. 15m).
ACCESS_TOKEN_TTL=15m

# Lifetime of a refresh session, in days.
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of browser origins allowed to call the API.
# Required in production. Sign-up, sign-in, session refresh and sign-out are
# refused from any other origin, even through the Vite proxy, so add
# http://localhost:4173 here to sign in on `vite preview`.
CORS_ORIGIN=http://localhost:5173

# Public URL of the web app. Used to build customer-facing links
# (e.g. public quote pages). Required in production.
APP_URL=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (0 when the API is
# exposed directly, 1 behind a single load balancer / PaaS router). Defaults to
# 0 in development; required in production, because a wrong value makes rate
# limiting treat every client as the proxy's single IP.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Adds an "Explore the demo" button (sign-in page and landing page) that signs
# visitors in to a shared demo business, created on first use and rebuilt every
# 24 hours. Real businesses are never touched. Leave false unless you want a
# public demo on this deployment.
DEMO_LOGIN_ENABLED=false

# Development only: a fixed password (at least 8 characters) for the demo users
# that `pnpm seed` creates, handy for repeat demos. When unset, the seed
# generates a new random password on every run. Never set it in production.
# SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Web (apps/web) — only VITE_* variables are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the API, including its /api prefix (e.g. https://api.example.com/api).
# Leave empty to use /api on the web app's own origin; in development the Vite
# proxy forwards those requests to the API on localhost at PORT (4000 by
# default). When the API is on another origin, CORS_ORIGIN must include the web
# app's origin.
# The sign-in refresh cookie is only sent when the web app and the API are
# same-site. Default PaaS hostnames (*.vercel.app, *.netlify.app, *.onrender.com,
# *.herokuapp.com, *.fly.dev, *.pages.dev, *.up.railway.app) are public
# suffixes, so two apps on them are cross-site: use a custom domain for both
# (e.g. app.example.com and api.example.com), or proxy /api through the web host
# and leave this empty.
VITE_API_URL=
