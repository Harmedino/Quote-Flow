{
  "name": "@quoteflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "QuoteFlow REST API (Express + MongoDB).",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "db:indexes": "tsx --env-file-if-exists=../../.env src/scripts/sync-indexes.ts",
    "db:indexes:prod": "node --enable-source-maps dist/scripts/sync-indexes.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "inter-ui": "^3.19.3",
    "jose": "^6.2.12",
    "mongoose": "^9.11.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@quoteflow/shared": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
